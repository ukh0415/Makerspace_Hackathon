<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vehicle">

  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(1/12)*m*(3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(1/12)*m*(3*r*r + h*h)}" iyz="0"
               izz="${(1/2)*m*r*r}" />
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.151" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="1.0 0.6 0.2"/></geometry>
      <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
    </visual>
    <collision><geometry><box size="1.0 0.6 0.2"/></geometry></collision>
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${(1/12)*15.0*(0.6*0.6 + 0.2*0.2)}" ixy="0" ixz="0"
               iyy="${(1/12)*15.0*(1.0*1.0 + 0.2*0.2)}" iyz="0"
               izz="${(1/12)*15.0*(1.0*1.0 + 0.6*0.6)}" />
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <geometry><cylinder length="0.1" radius="0.15"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <geometry><cylinder length="0.1" radius="0.15"/></geometry>
      </collision>
      <xacro:wheel_inertia m="1.0" r="0.15" h="0.1"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} -0.151"/> 
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_wheel">
      <material>Gazebo/Black</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left"  x="0.35"  y="0.3"/>
  <xacro:wheel name="front_right" x="0.35"  y="-0.3"/>
  <xacro:wheel name="rear_left"   x="-0.35" y="0.3"/>
  <xacro:wheel name="rear_right"  x="-0.35" y="-0.3"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.05" length="0.05"/></geometry></visual>
    <collision><geometry><cylinder radius="0.05" length="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.1"/><origin xyz="0 0 0"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0 0 0.125"/>
  </joint>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max></range>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="vehicle_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="mecanum_drive" filename="libgazebo_ros_planar_move.so">
      <ros><remapping>odom:=odom</remapping></ros>
      <update_rate>100</update_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame> 
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>